# Local profile: every dependency runs in Docker Compose; no Google Cloud access.
# Configuration: copy config/env/example/ to config/env/local/, fill it in, then
#   uv run sdlc-config publish --env local --to .data/config --activate
# Connection secrets need DATA_ENCRYPTION_KEY (32 random bytes, base64) in your shell, never in a file here:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
SDLC_ENV=local
LOG_LEVEL=INFO
STORE_HOST_PATH=./.data/store
CONFIG_HOST_PATH=./.data/config
