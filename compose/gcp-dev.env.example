# gcp-dev profile: services use the development project with your gcloud Application Default Credentials.
# Copy to compose/gcp-dev.env (git-ignored) and fill in. No service-account keys.
SDLC_ENV=gcp-dev
LOG_LEVEL=INFO
GOOGLE_CLOUD_PROJECT=
STORE_HOST_PATH=./.data/store
# The development configuration bucket (Terraform output config_bucket); publish and activate with
#   uv run sdlc-config publish --env dev --to gs://<config bucket> --activate
CONFIG_SOURCE=gs://
