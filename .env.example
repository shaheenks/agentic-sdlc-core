# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- Gemini: option A, Gemini API key ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# --- Gemini: option B, Vertex AI via gcloud ADC (`gcloud auth application-default login`) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# Needed when ADC has no quota project (403 "requires a quota project"):
# GOOGLE_CLOUD_QUOTA_PROJECT=
# ADC file mounted read-only into the agent container (default: Windows %APPDATA% location):
# GOOGLE_ADC_FILE=~/.config/gcloud/application_default_credentials.json

SDLC_AGENT_MODEL=gemini-3.8-flash

# --- Postgres (docker compose service, published on 127.0.0.1:PGPORT); see db/bootstrap/README.md ---
# Standard libpq vars: psql, psycopg and tests on the host pick them up directly.
# docker compose uses them to create the app role; containers override PGHOST=postgres.
# 127.0.0.1, not "localhost": localhost resolves to ::1 first, but Postgres is published on IPv4 only
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sdlc
PGUSER=sdlc_app
PGPASSWORD=sdlc-local
# Superuser: used only by init scripts; nothing connects as it at runtime.
POSTGRES_SUPERUSER_PASSWORD=postgres-local
# Schema owner (migrations) and ingest writer (Stage 5)
SDLC_OWNER_PASSWORD=sdlc-owner-local
SDLC_INGEST_PASSWORD=sdlc-ingest-local

# --- Entra ID (Stage 2): see docs/ENTRA_SETUP.md ---
# MCP server refuses to start until TENANT + API client ID are set (fail closed).
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
# Optional: tracing (H8.3). With `docker compose --profile observability up -d`: Jaeger UI http://localhost:16686
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Optional (E7, sovereign clouds): Entra login host for oauth2-proxy and the agent web app.
# Keep in sync with config/platform.yaml identity/authority_host. Default: commercial cloud.
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# Optional: Graph fallback for users with too many groups (secret of the sdlc-mcp app).
ENTRA_GRAPH_CLIENT_SECRET=
# Stage 2d: web sign-in for adk web via oauth2-proxy (sdlc-client app).
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Stage 2d: oauth2-proxy session cookie encryption key (32 random bytes, base64url):
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=

# --- Public endpoints via Cloudflare Tunnel (docs/CLOUDFLARE_TUNNEL.md) ---
# Tunnel connector: Windows service `Cloudflared` on the host (token held by the service).
# Start the public oauth2-proxy (localhost:4181) with: docker compose --profile tunnel up -d
SDLC_APP_HOST=app-sdlc-dev.shaheenks.co.in
SDLC_MCP_HOST=mcp-sdlc-dev.shaheenks.co.in
