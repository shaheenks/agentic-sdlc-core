{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc/v1/Team",
  "title": "Team",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "membership"],
  "properties": {
    "apiVersion": { "const": "sdlc/v1" },
    "kind": { "const": "Team" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": {
          "description": "one line on what the team does; shown to the agent for its member users (G9)",
          "type": "string", "maxLength": 200
        },
        "owners":{ "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
      }
    },
    "membership": {
      "description": "group / app role members; may be empty when members come from env/<env>/users.yaml",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roles"],
        "oneOf": [{ "required": ["group"] }, { "required": ["app_role"] }],
        "properties": {
          "group": { "$ref": "#/$defs/name" },
          "app_role": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
          "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deny": {
              "type": "array", "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
            },
            "constraints": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["args"],
                "properties": {
                  "args": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["in"],
                      "properties": {
                        "in": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "limits": {
          "description": "Per-user call rates for this team's members (most generous team wins; a tool limit applies on top of the overall one).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "calls_per_minute": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "tools": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["calls_per_minute"],
                "properties": { "calls_per_minute": { "type": "integer", "minimum": 1, "maximum": 100000 } }
              }
            }
          }
        }
      }
    },
    "addons": {
      "description": "Team add-ons (skills, agent instructions, context). Resolved in Stage 4.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "pattern": "^skills/teams/[a-z0-9/_-]+$" },
              "tags": {
                "description": "Only tags listed in platform.yaml skills/team_tags (G6); they grant nothing",
                "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" }
              },
              "access": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": { "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/name" } } }
              }
            }
          }
        },
        "flows": {
          "description": "Flow defaults for this team's documents (version-03 P10 G7); apply once the team is locked for a document",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "document": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lenses": { "$ref": "#/$defs/skills" },
                "types": {
                  "type": "object",
                  "propertyNames": { "$ref": "#/$defs/name" },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "template": { "$ref": "#/$defs/name" },
                      "brief": { "$ref": "#/$defs/name" },
                      "lenses": { "$ref": "#/$defs/skills" },
                      "required_lenses": { "$ref": "#/$defs/skills" }
                    }
                  }
                },
                "max_lenses": { "type": "integer", "minimum": 1 },
                "max_llm_calls_per_reviewer": { "type": "integer", "minimum": 1 },
                "max_rereviews": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "instructions": { "type": "string", "pattern": "^skills/teams/[A-Za-z0-9/_.-]+[.]md$" },
        "context": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "skills": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
  }
}
