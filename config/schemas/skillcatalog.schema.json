{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc/v1/SkillCatalog",
  "title": "SkillCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "skills"],
  "properties": {
    "apiVersion": { "const": "sdlc/v1" },
    "kind": { "const": "SkillCatalog" },
    "skills": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "pattern": "^skills/[a-z0-9/_-]+$" },
          "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
          "access": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/name" } },
              "teams": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/name" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  }
}
