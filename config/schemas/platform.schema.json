{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform-wide settings.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "content_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "max_bytes",
        "content_types"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "artifacts"
  ],
  "additionalProperties": false
}
