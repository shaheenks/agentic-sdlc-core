{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc/v1/Platform",
  "title": "Platform",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "identity", "classification_levels", "defaults", "knowledge"],
  "properties": {
    "apiVersion": { "const": "sdlc/v1" },
    "kind": { "const": "Platform" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "tenant_id", "authority_host", "graph_host", "issuer", "jwks_uri", "audience", "required_scopes", "groups"],
      "properties": {
        "provider": { "const": "entra" },
        "tenant_id": { "$ref": "#/$defs/guid" },
        "authority_host": { "type": "string", "pattern": "^https://[^/]+$", "description": "Entra login host (E7)" },
        "graph_host": { "type": "string", "pattern": "^https://[^/]+$", "description": "Microsoft Graph host (E7)" },
        "issuer": { "type": "string", "pattern": "^https://" },
        "jwks_uri": { "type": "string", "pattern": "^https://" },
        "audience": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_scopes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim", "overage_fallback", "cache_ttl_seconds"],
          "properties": {
            "claim": { "const": "groups" },
            "overage_fallback": { "enum": ["graph_transitive_member_of", "none"] },
            "cache_ttl_seconds": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "classification_levels": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedding"],
      "properties": {
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "dimensions"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "dimensions": { "const": 768, "description": "must match the vector(768) column" }
          }
        },
        "graph": {
          "description": "knowledge-graph extraction (Stage 6)",
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "relation_types"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "thinking_level": { "enum": ["low", "medium", "high"] },
            "relation_types": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
            }
          }
        },
        "ocr": {
          "description": "reading PDF pages that have no text layer (H10), for sources with pdf.ocr: gemini",
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "thinking_level": { "enum": ["low", "medium", "high"] }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deny_by_default", "max_classification"],
      "properties": {
        "deny_by_default": { "const": true },
        "max_classification": { "type": "string" },
        "rate_limit": {
          "description": "Baseline per-user tool call rate for everyone (teams may set their own).",
          "type": "object",
          "additionalProperties": false,
          "required": ["calls_per_minute"],
          "properties": { "calls_per_minute": { "type": "integer", "minimum": 1, "maximum": 100000 } }
        }
      }
    }
  },
  "$defs": {
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
