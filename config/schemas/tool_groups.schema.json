{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool groups: named sets of tools.",
  "type": "object",
  "properties": {
    "tool_groups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "everyone": {
            "const": true,
            "description": "Given to everyone."
          }
        },
        "required": [
          "description",
          "tools"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tool_groups"
  ],
  "additionalProperties": false
}
