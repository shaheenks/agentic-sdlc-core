{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grants of tool groups and knowledge sources.",
  "type": "object",
  "properties": {
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tool_groups": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "to": {
            "type": "object",
            "properties": {
              "everyone": {
                "const": true
              },
              "teams": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*(:[a-z][a-z0-9_-]*)?$"
                },
                "uniqueItems": true
              },
              "user_groups": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "required": [
          "id",
          "description",
          "to"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "tool_groups"
            ]
          },
          {
            "required": [
              "sources"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "grants"
  ],
  "additionalProperties": false
}
