{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teams of one environment (env/<env>/teams.yaml): their roles, what they are given, and their systems.",
  "type": "object",
  "properties": {
    "teams": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "systems": {
            "type": "object",
            "properties": {
              "jira": {
                "type": "array",
                "description": "The team's Jira projects; tools reach only these.",
                "items": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "base_url": {
                      "type": "string",
                      "pattern": "^https://[^\\s/]+(/[^\\s]*)?$"
                    },
                    "project": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]{0,19}$"
                    },
                    "feature_type": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Default Story: the feature, under its epic."
                    },
                    "story_type": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Default Sub-task (Subtask in team-managed projects): the user stories, under the feature."
                    },
                    "story_link": {
                      "enum": [
                        "parent",
                        "issue_link"
                      ],
                      "description": "How a story joins its feature. Default parent."
                    },
                    "default": {
                      "type": "boolean",
                      "description": "The team's default of this kind. Exactly one when the list has more than one entry."
                    },
                    "story_points_field": {
                      "type": "string",
                      "pattern": "^customfield_[0-9]{1,8}$",
                      "description": "The story points field, such as customfield_10016. Found by name when left out."
                    },
                    "epic_type": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Default Epic."
                    }
                  },
                  "required": [
                    "provider",
                    "base_url",
                    "project"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "confluence": {
                "type": "array",
                "description": "The team's Confluence spaces, each optionally narrowed to a parent page that new pages go under.",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "base_url": {
                      "type": "string",
                      "pattern": "^https://[^\\s/]+(/[^\\s]*)?$",
                      "description": "The site: https://<site>.atlassian.net/wiki, or the Data Center server."
                    },
                    "space": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_~-]{1,255}$",
                      "description": "The space key."
                    },
                    "parent_page": {
                      "type": "string",
                      "pattern": "^[0-9]{1,20}$",
                      "description": "The ID of the page new pages go under; the space's home page if left out."
                    },
                    "default": {
                      "type": "boolean",
                      "description": "The team's default of this kind. Exactly one when the list has more than one entry."
                    }
                  },
                  "required": [
                    "provider",
                    "base_url",
                    "space"
                  ],
                  "additionalProperties": false
                }
              },
              "repositories": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "repo": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                      "description": "owner/name (GitHub), workspace/slug (Bitbucket Cloud) or PROJECT/slug (Bitbucket Data Center)."
                    },
                    "base_url": {
                      "type": "string",
                      "pattern": "^https://[^\\s/]+(/[^\\s]*)?$",
                      "description": "Data Center: the server. Cloud: the provider's."
                    },
                    "default_branch": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Default main."
                    },
                    "design_path": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
                      "description": "Optional: where design documents live in this repository, for reading."
                    },
                    "default": {
                      "type": "boolean",
                      "description": "The team's default of this kind. Exactly one when the list has more than one entry."
                    },
                    "workspace": {
                      "type": "object",
                      "description": "How the Code Workspace builds and tests this repository, in the platform's image (Python and Node.js) (DEC-0015). Without it, implementation pull requests are proven by the repository's own CI alone.",
                      "properties": {
                        "setup": {
                          "$ref": "#/$defs/commands",
                          "description": "Run once after checkout, for example installing dependencies."
                        },
                        "build": {
                          "$ref": "#/$defs/commands"
                        },
                        "test": {
                          "$ref": "#/$defs/commands"
                        }
                      },
                      "required": [
                        "test"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "provider",
                    "repo"
                  ],
                  "additionalProperties": false
                },
                "description": "The product repositories the team may target."
              },
              "control_repo": {
                "type": "object",
                "description": "The team's sdlc-control repository: approved artifacts and the record of agent writes (DEC-0012). Any org/repo, such as example-org/sdlc-control; no two teams share one.",
                "properties": {
                  "provider": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "repo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                    "description": "owner/name (GitHub), workspace/slug (Bitbucket Cloud) or PROJECT/slug (Bitbucket Data Center)."
                  },
                  "base_url": {
                    "type": "string",
                    "pattern": "^https://[^\\s/]+(/[^\\s]*)?$",
                    "description": "Data Center: the server."
                  },
                  "branch": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Default main."
                  },
                  "system_accounts": {
                    "type": "array",
                    "description": "Accounts of system identities on the provider; a merge by one of them does not approve.",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "provider",
                  "repo"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "description": "The team's systems: Jira projects, Confluence spaces and product repositories, each list with one default, and its control repository (DEC-0012). Usually set per environment in env/<env>/teams.yaml."
          },
          "tool_groups": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "uniqueItems": true,
            "description": "Tool groups given to the members (FR-AUTHZ-007)."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "uniqueItems": true,
            "description": "Knowledge sources the members may read (DEC-0011)."
          },
          "role_grants": {
            "type": "object",
            "description": "Further tool groups and sources for one role of the team, such as lead.",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "tool_groups": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "uniqueItems": true,
                  "description": "Tool groups given to the members (FR-AUTHZ-007)."
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "uniqueItems": true,
                  "description": "Knowledge sources the members may read (DEC-0011)."
                }
              },
              "additionalProperties": false,
              "minProperties": 1
            }
          }
        },
        "required": [
          "name",
          "description",
          "roles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "teams"
  ],
  "additionalProperties": false,
  "$defs": {
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "description": "Shell commands, run in order from the repository root; the first that fails stops the run."
    }
  }
}
