{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teams and their roles.",
  "type": "object",
  "properties": {
    "teams": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "name",
          "description",
          "roles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "teams"
  ],
  "additionalProperties": false
}
