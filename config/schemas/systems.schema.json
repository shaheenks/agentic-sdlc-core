{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Each team's systems in this environment: its Jira project and repositories (env/<env>/systems.yaml).",
  "type": "object",
  "properties": {
    "teams": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "jira": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "base_url": {
                "type": "string",
                "pattern": "^https://[^\\s/]+(/[^\\s]*)?$"
              },
              "project": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,19}$"
              },
              "feature_type": {
                "type": "string",
                "minLength": 1,
                "description": "Default Feature."
              },
              "story_type": {
                "type": "string",
                "minLength": 1,
                "description": "Default User Story."
              },
              "story_link": {
                "enum": [
                  "parent",
                  "issue_link"
                ],
                "description": "How a story joins its feature. Default parent."
              },
              "design_status": {
                "type": "string",
                "minLength": 1,
                "description": "Default In Design."
              },
              "development_status": {
                "type": "string",
                "minLength": 1,
                "description": "Default In Development."
              }
            },
            "required": [
              "provider",
              "base_url",
              "project"
            ],
            "additionalProperties": false
          },
          "repositories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "repo": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                  "description": "owner/name (GitHub), workspace/slug (Bitbucket Cloud) or PROJECT/slug (Bitbucket Data Center)."
                },
                "base_url": {
                  "type": "string",
                  "pattern": "^https://[^\\s/]+(/[^\\s]*)?$",
                  "description": "Data Center: the server. Cloud: the provider's."
                },
                "default_branch": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Default main."
                },
                "design_path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
                  "description": "Where design specifications go, e.g. docs/specs."
                }
              },
              "required": [
                "provider",
                "repo",
                "design_path"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "teams"
  ],
  "additionalProperties": false
}
