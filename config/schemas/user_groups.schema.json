{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User groups that receive grants.",
  "type": "object",
  "properties": {
    "user_groups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "user_groups"
  ],
  "additionalProperties": false
}
