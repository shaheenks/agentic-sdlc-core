{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Google groups behind each team role and user group (env/<env>/groups.yaml).",
  "type": "object",
  "properties": {
    "teams": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "user_groups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "uniqueItems": true
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
